<!-- Step 6 physics model. Same plant as cartpole.py, but MuJoCo integrates it
     and the actuator is continuous.

     inertiafromgeom="false" and explicit <inertial> blocks on purpose: a
     capsule or cylinder geom does NOT have uniform-thin-rod inertia (a capsule
     adds hemispherical caps, a cylinder adds 3r^2/12), and the 4/3 in
     cartpole.py is exactly the uniform-rod assumption. Setting the inertia by
     hand makes the two plants the same object rather than nearly the same one,
     which is what lets mj_cartpole.py check MuJoCo's qacc against
     cartpole.accelerations() to 1e-12.

     Pole: uniform rod, length 2l = 1.0 m, mass 0.1 kg,
           I_transverse = m L^2 / 12 = 0.1/12 = 0.00833333...
           I_axial = 0 (thin rod); 1e-9 because MuJoCo needs it positive.
     Actuator: gear 10, ctrlrange [-1, 1], so ctrl = +-1 is exactly the +-10 N
           the discrete env's two actions apply. Same actuator authority; the
           only new freedom is everything in between. -->
<mujoco model="cartpole-continuous">
  <compiler inertiafromgeom="false" angle="radian"/>
  <option timestep="0.02" gravity="0 0 -9.8" integrator="Euler"
          density="0" viscosity="0"/>
  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.7 0.7 0.7"/>
    <global offwidth="960" offheight="640"/>
  </visual>
  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.22 0.25"
             rgb2="0.26 0.28 0.31" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="18 12" reflectance="0.05"/>
  </asset>
  <worldbody>
    <camera name="side" pos="0 -5.2 1.15" xyaxes="1 0 0 0 0.22 0.975"/>
    <light pos="0 -1.5 3" dir="0 0.4 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" pos="0 0 -0.35" size="20 12 0.1"
          material="grid" contype="0" conaffinity="0"/>
    <geom name="rail" type="capsule" fromto="-2.4 0 0 2.4 0 0" size="0.015"
          rgba="0.45 0.45 0.5 1" contype="0" conaffinity="0"/>
    <site name="limit_left"  pos="-2.4 0 0" size="0.05" rgba="0.9 0.2 0.2 1"/>
    <site name="limit_right" pos=" 2.4 0 0" size="0.05" rgba="0.9 0.2 0.2 1"/>
    <body name="cart" pos="0 0 0">
      <inertial pos="0 0 0" mass="1.0" diaginertia="1e-9 1e-9 1e-9"/>
      <joint name="slider" type="slide" axis="1 0 0" damping="0" armature="0"
             frictionloss="0"/>
      <geom name="cart" type="box" size="0.12 0.06 0.05" rgba="0.25 0.45 0.8 1"
            contype="0" conaffinity="0" mass="0"/>
      <body name="pole" pos="0 0 0">
        <inertial pos="0 0 0.5" mass="0.1"
                  diaginertia="0.008333333333333333 0.008333333333333333 1e-9"/>
        <joint name="hinge" type="hinge" axis="0 1 0" damping="0" armature="0"
               frictionloss="0"/>
        <geom name="pole" type="capsule" fromto="0 0 0 0 0 1.0" size="0.022"
              rgba="0.9 0.55 0.15 1" contype="0" conaffinity="0" mass="0"/>
        <site name="tip" pos="0 0 1.0" size="0.04" rgba="0.95 0.75 0.3 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor joint="slider" gear="10" ctrlrange="-1 1" ctrllimited="true"/>
  </actuator>
</mujoco>
