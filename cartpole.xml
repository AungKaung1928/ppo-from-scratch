<!-- Cart-pole, MJCF. Parameters match cartpole.py exactly: cart 1.0 kg, pole
     0.1 kg, pole HALF-length 0.5 m (so the capsule is 1.0 m long), g = 9.8,
     timestep 0.02, rail +-2.4 m.

     This model is here to LOOK AT, not to simulate. visualize.py integrates
     cartpole.py in numpy and writes the resulting (x, theta) into qpos, so
     MuJoCo is doing forward kinematics and rendering and nothing else. Letting
     MuJoCo integrate this would give a different trajectory -- different
     integrator, different contact and joint handling -- and every number in
     this repo is measured against the numpy plant. -->
<mujoco model="cartpole-barto-1983">
  <option timestep="0.02" gravity="0 0 -9.8" integrator="Euler"/>
  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.7 0.7 0.7"/>
    <global offwidth="960" offheight="640"/>
  </visual>
  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.22 0.25"
             rgb2="0.26 0.28 0.31" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="6 6" reflectance="0.05"/>
  </asset>
  <worldbody>
    <camera name="side" pos="0 -5.2 1.15" xyaxes="1 0 0 0 0.22 0.975"/>
    <light pos="0 -1.5 3" dir="0 0.4 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" pos="0 0 -0.35" size="20 12 0.1" material="grid"/>
    <geom name="rail" type="capsule" fromto="-2.4 0 0 2.4 0 0" size="0.015"
          rgba="0.45 0.45 0.5 1"/>
    <site name="limit_left"  pos="-2.4 0 0" size="0.05" rgba="0.9 0.2 0.2 1"/>
    <site name="limit_right" pos=" 2.4 0 0" size="0.05" rgba="0.9 0.2 0.2 1"/>
    <body name="cart" pos="0 0 0">
      <joint name="slider" type="slide" axis="1 0 0" range="-2.4 2.4" limited="true"/>
      <geom name="cart" type="box" size="0.12 0.06 0.05" mass="1.0"
            rgba="0.25 0.45 0.8 1"/>
      <body name="pole" pos="0 0 0">
        <joint name="hinge" type="hinge" axis="0 1 0"/>
        <geom name="pole" type="capsule" fromto="0 0 0 0 0 1.0" size="0.022"
              mass="0.1" rgba="0.9 0.55 0.15 1"/>
        <site name="tip" pos="0 0 1.0" size="0.04" rgba="0.95 0.75 0.3 1"/>
      </body>
    </body>
  </worldbody>
</mujoco>
